OXOMIUM_VERSION=1.0.0
OXOMIUM_PORT=8001
OXOMIUM_DEMO_INSTANCE=true
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=demo.example.org,127.0.0.1,localhost
LANGUAGE_CODE=en-us
TIME_ZONE=UTC
USE_I18N=True
USE_TZ=True
DB_NAME=data/demo.sqlite3
STATIC_URL=/static/
STATIC_ROOT=/app/staticfiles
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
DEMO_USERNAME=demo
DEMO_PASSWORD=replace-with-a-demo-password
